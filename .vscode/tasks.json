{
    "options": {
        "cwd": "${workspaceFolder}/build"
    },
    "tasks": [
        {
            "label": "cmake",
            "command": "cmake",
            "args": [
                "-DDEBUG=ON",
                ".."
            ]
        },
        {
            "label": "make",
            "command": "make"
        },
        {
            "label": "CMake Build",
            "dependsOn": [
                "cmake",
                "make"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "gen_parser",
            "type": "shell",
            "command": "cd ${workspaceFolder}/src/observer/sql/parser && bash gen_parser.sh",
            "problemMatcher": [],
            "presentation": {
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "preLaunchCompoundTask",
            "dependsOn": [
                "gen_parser",
                "CMake Build",
            ],
            "dependsOrder": "sequence"
        }
    ],
    "version": "2.0.0"
}